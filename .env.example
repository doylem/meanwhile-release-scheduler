# Copy this file to .env.local for local development (npm run script:*).
# In production, all of these live as GitHub Repository Secrets instead —
# see README.md "GitHub Secrets" for the full list and how to obtain each value.
# Never commit a real .env.local.

# --- Google (Calendar + Gmail) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=meanwhilerec@gmail.com

# --- Calendar attendees (configurable, never hardcoded) --------------------
GAVIN_EMAIL=
MATTY_EMAIL=
JAMES_EMAIL=
# Optional: comma-separated list overrides the three above if set.
ATTENDEE_EMAILS=

# --- Gmail draft settings ---------------------------------------------------
GMAIL_DRAFT_RECIPIENT=meanwhilerec@gmail.com

# --- Dropbox -----------------------------------------------------------------
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_BASE_PATH=/Meanwhile/Releases

# --- App access (light deterrent only — see README "Security model") -------
NEXT_PUBLIC_APP_PASSWORD=

# --- Frontend -> GitHub Actions wiring (non-secret, baked into the build) --
NEXT_PUBLIC_GITHUB_OWNER=
NEXT_PUBLIC_GITHUB_REPO=

# --- Local script runs --------------------------------------------------
DRY_RUN=true
